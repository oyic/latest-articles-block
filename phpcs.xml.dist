<?xml version="1.0"?>
<ruleset name="Latest Articles">
	<description>WordPress Coding Standards and PHP compatibility for the Latest Articles plugin.</description>

	<file>.</file>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!-- Match the plugin header: Requires at least 6.8, Requires PHP 7.4. -->
	<config name="minimum_wp_version" value="6.8"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="latest-articles-block"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="oyic"/>
			</property>
		</properties>
	</rule>
</ruleset>
