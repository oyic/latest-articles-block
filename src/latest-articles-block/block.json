{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "oyic/latest-articles-block",
	"version": "0.1.0",
	"title": "Latest Articles",
	"category": "widgets",
	"icon": "excerpt-view",
	"description": "Featured post plus four cards from a chosen category.",
	"example": {},
	"attributes": {
		"categoryId": {
			"type": "number",
			"default": 0
		},
		"showCategoryLabel": {
			"type": "boolean",
			"default": true
		},
		"showExcerpt": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	},
	"styles": [
		{ "name": "default", "label": "Default", "isDefault": true },
		{ "name": "hover-zoom", "label": "Zoom on hover" },
		{ "name": "hover-dim", "label": "Dim on hover" }
	],
	"textdomain": "latest-articles-block",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
